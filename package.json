{
  "name": "workadventure-map-starter-kit",
  "version": "3.3.11",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build --config buildmap.vite.config.ts",
    "prod": "vite preview",
    "optimize": "cd dist/ && for i in $(ls -1 *.tmj); do jq -c . $i > tmp.tmj; mv tmp.tmj $i; done"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@workadventure/iframe-api-typings": "^1.32.10",
    "dotenv": "^16.3.1",
    "rollup": "npm:@rollup/wasm-node@^4.62.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.0",
    "wa-map-optimizer-vite": "^1.3.1"
  },
  "dependencies": {
    "@workadventure/map-starter-kit-core": "^1.1.5",
    "@workadventure/scripting-api-extra": "^1.9.12",
    "wa-map-optimizer-vite": "^1.3.1"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.62.3"
  }
}
